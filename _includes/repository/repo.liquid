{% assign gh_repo = site.data.github.repos[include.repository] %}
{% assign repo_url = include.repository | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign repo_name = repo_url.last %}
{% else %}
  {% assign repo_name = include.repository %}
{% endif %}
<div class="repo p-2">
  <a class="repo-card" href="https://github.com/{{ include.repository }}">
    <div class="repo-card-title">
      <i class="fa-solid fa-book-bookmark"></i>
      {{ repo_name | replace: '-', ' ' }}
    </div>
    {% if gh_repo.description %}
      <p class="repo-card-description">{{ gh_repo.description }}</p>
    {% endif %}
    {% if gh_repo %}
      <div class="repo-card-meta">
        {% if gh_repo.language %}
          <span><i class="fa-solid fa-circle repo-language-dot"></i> {{ gh_repo.language }}</span>
        {% endif %}
        <span><i class="fa-regular fa-star"></i> {{ gh_repo.stargazers_count }}</span>
        <span><i class="fa-solid fa-code-fork"></i> {{ gh_repo.forks_count }}</span>
      </div>
    {% endif %}
  </a>
</div>
